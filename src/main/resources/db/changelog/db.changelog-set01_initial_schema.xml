<?xml version="1.0" encoding="UTF-8"?>
<!-- Initial schema. Types are portable between H2 (PostgreSQL mode) and PostgreSQL. -->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="set01-01-store" author="beacon">
        <createTable tableName="store">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_store"/>
            </column>
            <column name="domain" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_store_domain"/>
            </column>
            <column name="display_name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="platform" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="currency" type="VARCHAR(3)"/>
            <column name="status" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="current_snapshot_id" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
        </createTable>
        <sql>ALTER TABLE store ADD CONSTRAINT chk_store_platform CHECK (platform IN ('SHOPIFY','GENERIC','REPLAY'))</sql>
        <sql>ALTER TABLE store ADD CONSTRAINT chk_store_status CHECK (status IN ('ADDING','ACTIVE','FAILED'))</sql>
        <rollback><dropTable tableName="store"/></rollback>
    </changeSet>

    <changeSet id="set01-02-snapshot" author="beacon">
        <createTable tableName="snapshot">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_snapshot"/>
            </column>
            <column name="store_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_snapshot_store" references="store(id)"/>
            </column>
            <column name="schema_version" type="INT"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="started_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="finished_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="product_count" type="INT"/>
            <column name="variant_count" type="INT"/>
            <column name="raw_path" type="VARCHAR(512)"/>
            <column name="error_code" type="VARCHAR(50)"/>
            <column name="error_message" type="VARCHAR(1000)"/>
        </createTable>
        <sql>ALTER TABLE snapshot ADD CONSTRAINT chk_snapshot_status CHECK (status IN ('RUNNING','COMPLETE','FAILED'))</sql>
        <createIndex tableName="snapshot" indexName="idx_snapshot_store_started">
            <column name="store_id"/>
            <column name="started_at" descending="true"/>
        </createIndex>
        <addForeignKeyConstraint baseTableName="store" baseColumnNames="current_snapshot_id"
                                 constraintName="fk_store_current_snapshot"
                                 referencedTableName="snapshot" referencedColumnNames="id"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="store" constraintName="fk_store_current_snapshot"/>
            <dropTable tableName="snapshot"/>
        </rollback>
    </changeSet>

    <changeSet id="set01-03-product" author="beacon">
        <createTable tableName="product">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_product"/>
            </column>
            <column name="store_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_product_store" references="store(id)"/>
            </column>
            <column name="external_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="handle" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="title" type="VARCHAR(500)"><constraints nullable="false"/></column>
            <column name="product_type" type="VARCHAR(255)"/>
            <column name="vendor" type="VARCHAR(255)"/>
            <column name="tags" type="CLOB"/>
            <column name="image_url" type="VARCHAR(1000)"/>
            <column name="image_count" type="INT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="description_length" type="INT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="published_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="in_best_seller_collection" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="promoted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="exclusion" type="VARCHAR(30)"/>
            <column name="removed" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="last_snapshot_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_product_snapshot" references="snapshot(id)"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="product" columnNames="store_id, external_id" constraintName="uq_product_store_external"/>
        <createIndex tableName="product" indexName="idx_product_store_type">
            <column name="store_id"/>
            <column name="product_type"/>
        </createIndex>
        <rollback><dropTable tableName="product"/></rollback>
    </changeSet>

    <changeSet id="set01-04-variant" author="beacon">
        <createTable tableName="variant">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_variant"/>
            </column>
            <column name="store_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_variant_store" references="store(id)"/>
            </column>
            <column name="product_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_variant_product" references="product(id)"/>
            </column>
            <column name="external_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="title" type="VARCHAR(500)"><constraints nullable="false"/></column>
            <column name="option1" type="VARCHAR(255)"/>
            <column name="option2" type="VARCHAR(255)"/>
            <column name="option3" type="VARCHAR(255)"/>
            <column name="size_label" type="VARCHAR(100)"/>
            <column name="size_kind" type="VARCHAR(20)"/>
            <column name="size_rank" type="INT"/>
            <column name="is_core_size" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="sku" type="VARCHAR(255)"/>
            <column name="price" type="NUMERIC(12,2)"><constraints nullable="false"/></column>
            <column name="compare_at_price" type="NUMERIC(12,2)"/>
            <column name="available" type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="removed" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="last_snapshot_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_variant_snapshot" references="snapshot(id)"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="variant" columnNames="store_id, external_id" constraintName="uq_variant_store_external"/>
        <createIndex tableName="variant" indexName="idx_variant_product"><column name="product_id"/></createIndex>
        <createIndex tableName="variant" indexName="idx_variant_store_available">
            <column name="store_id"/>
            <column name="available"/>
        </createIndex>
        <rollback><dropTable tableName="variant"/></rollback>
    </changeSet>

    <changeSet id="set01-05-change-event" author="beacon">
        <createTable tableName="change_event">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_change_event"/>
            </column>
            <column name="store_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_change_store" references="store(id)"/>
            </column>
            <column name="from_snapshot_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_change_from_snapshot" references="snapshot(id)"/>
            </column>
            <column name="to_snapshot_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_change_to_snapshot" references="snapshot(id)"/>
            </column>
            <column name="product_id" type="BIGINT">
                <constraints foreignKeyName="fk_change_product" references="product(id)"/>
            </column>
            <column name="variant_id" type="BIGINT">
                <constraints foreignKeyName="fk_change_variant" references="variant(id)"/>
            </column>
            <column name="type" type="VARCHAR(30)"><constraints nullable="false"/></column>
            <column name="old_value" type="VARCHAR(255)"/>
            <column name="new_value" type="VARCHAR(255)"/>
            <column name="window_start" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="window_end" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
        </createTable>
        <sql>ALTER TABLE change_event ADD CONSTRAINT chk_change_type CHECK (type IN ('SOLD_OUT','RESTOCKED','PRICE_CHANGED','PRODUCT_ADDED','PRODUCT_REMOVED','VARIANT_ADDED','VARIANT_REMOVED'))</sql>
        <createIndex tableName="change_event" indexName="idx_change_store_window">
            <column name="store_id"/>
            <column name="window_end" descending="true"/>
        </createIndex>
        <createIndex tableName="change_event" indexName="idx_change_variant"><column name="variant_id"/></createIndex>
        <rollback><dropTable tableName="change_event"/></rollback>
    </changeSet>

    <changeSet id="set01-06-job" author="beacon">
        <createTable tableName="job">
            <column name="id" type="UUID">
                <constraints primaryKey="true" primaryKeyName="pk_job"/>
            </column>
            <column name="store_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_job_store" references="store(id)"/>
            </column>
            <column name="type" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="step" type="VARCHAR(30)"/>
            <column name="products_read" type="INT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="products_estimate" type="INT"/>
            <column name="error_code" type="VARCHAR(50)"/>
            <column name="message" type="VARCHAR(1000)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
        </createTable>
        <sql>ALTER TABLE job ADD CONSTRAINT chk_job_type CHECK (type IN ('ADD_STORE','REFRESH','SCHEDULED'))</sql>
        <sql>ALTER TABLE job ADD CONSTRAINT chk_job_status CHECK (status IN ('QUEUED','RUNNING','SUCCEEDED','FAILED'))</sql>
        <createIndex tableName="job" indexName="idx_job_store_status">
            <column name="store_id"/>
            <column name="status"/>
        </createIndex>
        <rollback><dropTable tableName="job"/></rollback>
    </changeSet>

    <changeSet id="set01-07-action-status" author="beacon">
        <createTable tableName="action_status">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_action_status"/>
            </column>
            <column name="store_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_action_store" references="store(id)"/>
            </column>
            <column name="action_key" type="VARCHAR(200)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
        </createTable>
        <sql>ALTER TABLE action_status ADD CONSTRAINT chk_action_status CHECK (status IN ('TODO','DONE','DISMISSED'))</sql>
        <addUniqueConstraint tableName="action_status" columnNames="store_id, action_key" constraintName="uq_action_store_key"/>
        <rollback><dropTable tableName="action_status"/></rollback>
    </changeSet>

    <changeSet id="set01-08-insight-report" author="beacon">
        <createTable tableName="insight_report">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_insight_report"/>
            </column>
            <column name="store_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_report_store" references="store(id)"/>
            </column>
            <column name="snapshot_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_report_snapshot"
                             foreignKeyName="fk_report_snapshot" references="snapshot(id)"/>
            </column>
            <column name="assumptions_version" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="generated_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="payload" type="CLOB"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="insight_report" indexName="idx_report_store_generated">
            <column name="store_id"/>
            <column name="generated_at" descending="true"/>
        </createIndex>
        <rollback><dropTable tableName="insight_report"/></rollback>
    </changeSet>
</databaseChangeLog>
